{
  "bindings": {
    "app.exit": "ctrl+q",
    "app.suspend": "ctrl+z",
    "app.thinking.cycle": "shift+tab",
    "app.thinking.toggle": "ctrl+t",
    "app.session.toggleNamedFilter": "ctrl+n",
    "app.editor.external": "ctrl+g",
    "app.message.followUp": "alt+enter",
    "app.message.dequeue": "alt+up",
    "app.clipboard.pasteImage": "ctrl+v",
    "app.session.tree": "f2",
    "app.model.select": "f3",
    "app.notifications.clear": "f8",
    "tui.input.newLine": "shift+enter",
    "tui.input.submit": "enter",
    "tui.input.tab": "tab",
    "tui.select.up": "up",
    "tui.select.down": "down",
    "tui.select.cancel": "esc",
    "tui.editor.cursorLeft": "left",
    "tui.editor.cursorRight": "right",
    "tui.editor.cursorWordLeft": "alt+left",
    "tui.editor.cursorWordRight": "alt+right",
    "tui.editor.cursorLineStart": "home",
    "tui.editor.cursorLineEnd": "end",
    "tui.editor.deleteCharBackward": "backspace",
    "tui.editor.deleteCharForward": "delete",
    "tui.editor.deleteWordBackward": "ctrl+w",
    "tui.editor.deleteWordForward": "alt+d",
    "tui.editor.deleteToLineStart": "ctrl+u",
    "tui.editor.deleteToLineEnd": "ctrl+k",
    "tui.editor.yank": "ctrl+y",
    "tui.editor.yankPop": "alt+y",
    "tui.editor.undo": "ctrl+-",
    "tui.timeline.pageUp": "pageup",
    "tui.timeline.pageDown": "pagedown"
  }
}
